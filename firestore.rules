rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the request from a signed-in user? ──────────────────────
    function isAuth() {
      return request.auth != null;
    }

    // ── Profiles ────────────────────────────────────────────────────────────
    // ANY logged-in user can READ all profiles (so the attorney directory works).
    // Only the profile owner can CREATE / UPDATE / DELETE their own profile.
    match /profiles/{profileId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuth() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuth() && resource.data.ownerUid == request.auth.uid;
    }

    // ── Cases ────────────────────────────────────────────────────────────────
    // Each user can only see and manage their own cases.
    match /cases/{caseId} {
      allow read:   if isAuth() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuth() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuth() && resource.data.ownerUid == request.auth.uid;
    }

    // ── Case Types (shared list) ─────────────────────────────────────────────
    // Anyone logged in can read and write case types (they're system-wide).
    match /caseTypes/{typeId} {
      allow read, write: if isAuth();
    }

    // ── Allowed Users (admin registry) ──────────────────────────────────────
    // Anyone logged in can read (needed for admin check).
    // Only admins can write — or a user can write their own record on first login.
    match /allowedUsers/{userId} {
      allow read:  if isAuth();
      allow write: if isAuth() && (
        // User can create/update their own record
        userId == request.auth.uid
        // OR an existing admin can manage others
        // (add admin check here if you want stricter control)
      );
    }

  }
}
